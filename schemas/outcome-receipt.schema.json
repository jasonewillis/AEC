{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonewillis/AEC/schemas/outcome-receipt.schema.json",
  "additionalProperties": false,
  "properties": {
    "coaching": {
      "additionalProperties": false,
      "properties": {
        "burden": {"enum": ["low", "moderate", "high"]},
        "transfer": {"enum": ["none", "partial", "full"]}
      },
      "required": ["burden", "transfer"],
      "type": "object"
    },
    "decision": {
      "additionalProperties": false,
      "properties": {
        "resolution_hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
        "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "selected_choice": {"$ref": "#/$defs/identity"}
      },
      "required": ["resolution_hash", "revision", "selected_choice"],
      "type": "object"
    },
    "observed_result": {
      "additionalProperties": false,
      "properties": {
        "measure": {"$ref": "#/$defs/identity"},
        "unit": {"$ref": "#/$defs/identity"},
        "value": {"$ref": "#/$defs/canonical_integer"}
      },
      "required": ["measure", "unit", "value"],
      "type": "object"
    },
    "observed_revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "schema_version": {"const": "1.0.0"},
    "verdict": {
      "enum": [
        "supported",
        "partially-supported",
        "unsupported",
        "harmful",
        "inconclusive"
      ]
    },
    "verification": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accepted": {"type": "boolean"},
          "kind": {"$ref": "#/$defs/identity"},
          "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
        },
        "required": ["accepted", "kind", "revision"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "coaching",
    "decision",
    "observed_result",
    "observed_revision",
    "schema_version",
    "verdict",
    "verification"
  ],
  "$defs": {
    "canonical_integer": {
      "pattern": "^(?:0|-?[1-9][0-9]*)$(?![\\s\\S])",
      "type": "string"
    },
    "identity": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])",
      "type": "string"
    }
  },
  "title": "AEC Local Decision Outcome Receipt",
  "type": "object"
}
