{
  "$defs": {
    "canonical_integer": {
      "pattern": "^(?:0|-?[1-9][0-9]*)$(?![\\s\\S])",
      "type": "string"
    },
    "consumer_profile": {
      "additionalProperties": false,
      "properties": {
        "aec_mode": {
          "const": "read-only-mentor"
        },
        "agent_adapters": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "lifecycle_authority": {
          "const": "consumer-owned"
        },
        "profile_version": {
          "minLength": 1,
          "type": "string"
        },
        "project": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$(?![\\s\\S])",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "workflow": {
          "const": "ticket-to-pr"
        }
      },
      "required": [
        "aec_mode",
        "agent_adapters",
        "lifecycle_authority",
        "profile_version",
        "project",
        "schema_version",
        "workflow"
      ],
      "type": "object"
    },
    "decision_context": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "additionalProperties": false,
          "properties": {
            "owner": {
              "enum": [
                "agent",
                "consumer-owner",
                "external"
              ]
            },
            "reason": {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            }
          },
          "required": [
            "owner",
            "reason"
          ],
          "type": "object"
        },
        "choices": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "identity": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])",
                "type": "string"
              },
              "summary": {
                "minLength": 1,
                "pattern": ".*\\S.*",
                "type": "string"
              },
              "tradeoffs": {
                "additionalProperties": false,
                "properties": {
                  "maintainability": {
                    "minLength": 1,
                    "pattern": ".*\\S.*",
                    "type": "string"
                  },
                  "quality": {
                    "minLength": 1,
                    "pattern": ".*\\S.*",
                    "type": "string"
                  },
                  "reversibility": {
                    "minLength": 1,
                    "pattern": ".*\\S.*",
                    "type": "string"
                  },
                  "risk": {
                    "minLength": 1,
                    "pattern": ".*\\S.*",
                    "type": "string"
                  },
                  "scope": {
                    "minLength": 1,
                    "pattern": ".*\\S.*",
                    "type": "string"
                  }
                },
                "required": [
                  "maintainability",
                  "quality",
                  "reversibility",
                  "risk",
                  "scope"
                ],
                "type": "object"
              }
            },
            "required": [
              "identity",
              "summary",
              "tradeoffs"
            ],
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 2,
          "type": "array"
        },
        "context": {
          "additionalProperties": false,
          "properties": {
            "evidence_quality": {
              "enum": [
                "direct-verified",
                "indirect",
                "assumed"
              ]
            },
            "revision": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            }
          },
          "required": [
            "evidence_quality",
            "revision"
          ],
          "type": "object"
        },
        "question": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        "recommendation": {
          "additionalProperties": false,
          "properties": {
            "choice": {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "expected_result": {
              "additionalProperties": false,
              "properties": {
                "baseline": {
                  "$ref": "#/$defs/canonical_integer"
                },
                "direction": {
                  "enum": [
                    "increase",
                    "decrease",
                    "hold"
                  ]
                },
                "measure": {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])",
                  "type": "string"
                },
                "target": {
                  "$ref": "#/$defs/canonical_integer"
                },
                "threshold": {
                  "minLength": 1,
                  "pattern": ".*\\S.*",
                  "type": "string"
                },
                "unit": {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])",
                  "type": "string"
                }
              },
              "required": [
                "baseline",
                "direction",
                "measure",
                "target",
                "threshold",
                "unit"
              ],
              "type": "object"
            },
            "falsifier": {
              "description": "The observation that would show this recommendation was wrong. Not doubt (principal_uncertainty), not timing (revisit_when), and not the target (expected_result) -- the thing that, if seen, refutes it.",
              "minLength": 1,
              "type": "string"
            },
            "principal_uncertainty": {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            "revisit_when": {
              "items": {
                "minLength": 1,
                "pattern": ".*\\S.*",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "why": {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            }
          },
          "required": [
            "choice",
            "confidence",
            "expected_result",
            "falsifier",
            "principal_uncertainty",
            "revisit_when",
            "why"
          ],
          "type": "object"
        },
        "schema_version": {
          "const": "2.0.0"
        }
      },
      "required": [
        "authority",
        "choices",
        "context",
        "question",
        "recommendation",
        "schema_version"
      ],
      "type": "object"
    },
    "observation_context": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "oneOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority": {
          "additionalProperties": false,
          "properties": {
            "owner": {
              "enum": [
                "agent",
                "consumer-owner",
                "external"
              ]
            },
            "reason": {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            }
          },
          "required": [
            "owner",
            "reason"
          ],
          "type": "object"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "context": {
          "additionalProperties": false,
          "properties": {
            "evidence_quality": {
              "enum": [
                "direct-verified",
                "indirect",
                "assumed"
              ]
            },
            "revision": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            }
          },
          "required": [
            "evidence_quality",
            "revision"
          ],
          "type": "object"
        },
        "instances": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "recognition_heuristic": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        "refuted_if": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "statement": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "type": "string"
        }
      },
      "required": [
        "action",
        "authority",
        "confidence",
        "context",
        "instances",
        "recognition_heuristic",
        "refuted_if",
        "schema_version",
        "statement"
      ],
      "type": "object"
    },
    "procedure_reference": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "identity",
        "revision"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/jasonewillis/AEC/schemas/consumer-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow_position": {
            "properties": {
              "phase": {
                "enum": [
                  "Intake",
                  "Framing"
                ]
              }
            },
            "required": [
              "phase"
            ]
          }
        },
        "required": [
          "workflow_position"
        ]
      },
      "then": {
        "properties": {
          "workflow_position": {
            "properties": {
              "stage": {
                "const": "Understand"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_position": {
            "properties": {
              "phase": {
                "enum": [
                  "Spec",
                  "Plan"
                ]
              }
            },
            "required": [
              "phase"
            ]
          }
        },
        "required": [
          "workflow_position"
        ]
      },
      "then": {
        "properties": {
          "workflow_position": {
            "properties": {
              "stage": {
                "const": "Design"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_position": {
            "properties": {
              "phase": {
                "enum": [
                  "Build",
                  "Verify"
                ]
              }
            },
            "required": [
              "phase"
            ]
          }
        },
        "required": [
          "workflow_position"
        ]
      },
      "then": {
        "properties": {
          "workflow_position": {
            "properties": {
              "stage": {
                "const": "Execute"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_position": {
            "properties": {
              "phase": {
                "enum": [
                  "Review",
                  "PR",
                  "Deploy"
                ]
              }
            },
            "required": [
              "phase"
            ]
          }
        },
        "required": [
          "workflow_position"
        ]
      },
      "then": {
        "properties": {
          "workflow_position": {
            "properties": {
              "stage": {
                "const": "Assure & Release"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "identity": {
            "minLength": 1,
            "type": "string"
          },
          "reason_code": {
            "enum": [
              "AUTHORITY_CONFLICT",
              "EVIDENCE_CONTRADICTED",
              "LIFECYCLE_STATE_STALE",
              "POLICY_CONFLICT",
              "PRIVATE_INPUT_INCLUDED"
            ],
            "type": "string"
          }
        },
        "required": [
          "active",
          "identity",
          "reason_code"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "capabilities": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "identity": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "capabilities",
        "identity",
        "version"
      ],
      "type": "object"
    },
    "consumer_profile": {
      "$ref": "#/$defs/consumer_profile"
    },
    "decision_context": {
      "oneOf": [
        {
          "$ref": "#/$defs/decision_context"
        },
        {
          "type": "null"
        }
      ]
    },
    "effects": {
      "additionalProperties": false,
      "properties": {
        "executes": {
          "const": false
        },
        "mutates": {
          "const": false
        }
      },
      "required": [
        "executes",
        "mutates"
      ],
      "type": "object"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "identity"
      ],
      "type": "object"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "environment": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          }
        },
        "required": [
          "accepted",
          "environment",
          "kind",
          "revision"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "observation_context": {
      "oneOf": [
        {
          "$ref": "#/$defs/observation_context"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "additionalProperties": false,
          "properties": {
            "require_exact_environment": {
              "const": true
            },
            "require_exact_revision": {
              "const": true
            }
          },
          "required": [
            "require_exact_environment",
            "require_exact_revision"
          ],
          "type": "object"
        },
        "identity": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "facts",
        "identity",
        "revision"
      ],
      "type": "object"
    },
    "procedures": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "items": {
            "$ref": "#/$defs/procedure_reference"
          },
          "type": "array",
          "uniqueItems": true
        },
        "required": {
          "$ref": "#/$defs/procedure_reference"
        }
      },
      "required": [
        "available",
        "required"
      ],
      "type": "object"
    },
    "provider": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "revision"
      ],
      "type": "object"
    },
    "revision": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "identity"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "task": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "identity"
      ],
      "type": "object"
    },
    "workflow_position": {
      "additionalProperties": false,
      "properties": {
        "lane": {
          "minLength": 1,
          "type": "string"
        },
        "phase": {
          "enum": [
            "Intake",
            "Framing",
            "Spec",
            "Plan",
            "Build",
            "Verify",
            "Review",
            "PR",
            "Deploy"
          ]
        },
        "stage": {
          "enum": [
            "Understand",
            "Design",
            "Execute",
            "Assure & Release"
          ]
        },
        "workflow": {
          "const": "ticket-to-pr"
        },
        "workflow_revision": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "lane",
        "phase",
        "stage",
        "workflow",
        "workflow_revision"
      ],
      "type": "object"
    }
  },
  "required": [
    "blockers",
    "capabilities",
    "consumer_profile",
    "effects",
    "environment",
    "evidence",
    "expires_at",
    "observed_at",
    "policy",
    "procedures",
    "provider",
    "revision",
    "schema_version",
    "task",
    "workflow_position"
  ],
  "title": "AEC Consumer State Provider Record",
  "type": "object"
}
