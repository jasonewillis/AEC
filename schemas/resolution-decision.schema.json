{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonewillis/AEC/schemas/resolution-decision.schema.json",
  "additionalProperties": false,
  "properties": {
    "allowed": {"type": "boolean"},
    "anti_example": {"minLength": 1, "type": "string"},
    "available_procedures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "identity": {"minLength": 1, "type": "string"},
          "revision": {"minLength": 1, "type": "string"}
        },
        "required": ["identity", "revision"],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "capability_profile_version": {"minLength": 1, "type": "string"},
    "environment": {"minLength": 1, "type": "string"},
    "executes": {"const": false},
    "finished": {
      "items": {"minLength": 1, "type": "string"},
      "minItems": 1,
      "type": "array"
    },
    "gate": {"enum": ["Blocked", "Needs review", "Evidence needed", "Ready"]},
    "good": {
      "items": {"minLength": 1, "type": "string"},
      "minItems": 1,
      "type": "array"
    },
    "input_bindings": {
      "additionalProperties": false,
      "properties": {
        "procedure_catalog": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "resolution_request": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": ["procedure_catalog", "resolution_request"],
      "type": "object"
    },
    "lane": {"minLength": 1, "type": "string"},
    "mutates": {"const": false},
    "phase": {"enum": ["Intake", "Framing", "Spec", "Plan", "Build", "Verify", "Review", "PR", "Deploy"]},
    "policy_version": {"minLength": 1, "type": "string"},
    "primary_blocker": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "identity": {"minLength": 1, "type": "string"},
            "reason_code": {
              "enum": [
                "AUTHORITY_CONFLICT",
                "EVIDENCE_CONTRADICTED",
                "LIFECYCLE_STATE_STALE",
                "POLICY_CONFLICT",
                "PRIVATE_INPUT_INCLUDED",
                "SKILL_UNAVAILABLE"
              ]
            }
          },
          "required": ["identity", "reason_code"],
          "type": "object"
        },
        {"type": "null"}
      ]
    },
    "primary_procedure": {
      "oneOf": [
        {"minLength": 1, "type": "string"},
        {"type": "null"}
      ]
    },
    "project_profile_version": {"minLength": 1, "type": "string"},
    "rationale": {
      "additionalProperties": false,
      "properties": {
        "principle_ids": {
          "items": {"minLength": 1, "type": "string"},
          "minItems": 1,
          "type": "array"
        },
        "summary": {"minLength": 1, "type": "string"}
      },
      "required": ["principle_ids", "summary"],
      "type": "object"
    },
    "reason_code": {
      "enum": [
        "ACCEPTANCE_EVIDENCE_COMPLETE",
        "ACCEPTANCE_EVIDENCE_INCOMPLETE",
        "AUTHORITY_CONFLICT",
        "EVIDENCE_CONTRADICTED",
        "LIFECYCLE_STATE_STALE",
        "POLICY_CONFLICT",
        "PRIVATE_INPUT_INCLUDED",
        "SKILL_UNAVAILABLE"
      ],
      "type": "string"
    },
    "required_evidence": {"items": {"minLength": 1, "type": "string"}, "type": "array"},
    "required_procedure": {
      "additionalProperties": false,
      "properties": {
        "identity": {"minLength": 1, "type": "string"},
        "revision": {"minLength": 1, "type": "string"}
      },
      "required": ["identity", "revision"],
      "type": "object"
    },
    "resolution_hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "schema_version": {"const": "3.0.0"},
    "source_identities": {
      "additionalProperties": false,
      "properties": {
        "capability_profile": {"minLength": 1, "type": "string"},
        "consumer_profile": {"minLength": 1, "type": "string"},
        "policy": {"minLength": 1, "type": "string"},
        "procedure": {"minLength": 1, "type": "string"},
        "workflow": {"minLength": 1, "type": "string"}
      },
      "required": [
        "capability_profile",
        "consumer_profile",
        "policy",
        "procedure",
        "workflow"
      ],
      "type": "object"
    },
    "source_revisions": {
      "additionalProperties": false,
      "properties": {
        "capability_profile": {"minLength": 1, "type": "string"},
        "consumer_profile": {"minLength": 1, "type": "string"},
        "policy": {"minLength": 1, "type": "string"},
        "procedure": {"minLength": 1, "type": "string"},
        "workflow": {"minLength": 1, "type": "string"}
      },
      "required": [
        "capability_profile",
        "consumer_profile",
        "policy",
        "procedure",
        "workflow"
      ],
      "type": "object"
    },
    "task_id": {"minLength": 1, "type": "string"},
    "workflow": {"minLength": 1, "type": "string"},
    "workflow_stage": {"enum": ["Understand", "Design", "Execute", "Assure & Release"]}
  },
  "required": [
    "allowed",
    "anti_example",
    "available_procedures",
    "capability_profile_version",
    "environment",
    "executes",
    "finished",
    "gate",
    "good",
    "input_bindings",
    "lane",
    "mutates",
    "phase",
    "policy_version",
    "primary_blocker",
    "primary_procedure",
    "project_profile_version",
    "rationale",
    "reason_code",
    "required_evidence",
    "required_procedure",
    "resolution_hash",
    "revision",
    "schema_version",
    "source_identities",
    "source_revisions",
    "task_id",
    "workflow",
    "workflow_stage"
  ],
  "oneOf": [
    {
      "properties": {
        "primary_blocker": {"type": "null"},
        "primary_procedure": {"minLength": 1, "type": "string"}
      }
    },
    {
      "properties": {
        "primary_blocker": {"type": "object"},
        "primary_procedure": {"type": "null"}
      }
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"gate": {"const": "Ready"}}},
      "then": {
        "properties": {
          "allowed": {"const": true},
          "primary_blocker": {"type": "null"},
          "primary_procedure": {"minLength": 1, "type": "string"},
          "reason_code": {"const": "ACCEPTANCE_EVIDENCE_COMPLETE"},
          "required_evidence": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"gate": {"const": "Evidence needed"}}},
      "then": {
        "properties": {
          "allowed": {"const": true},
          "primary_blocker": {"type": "null"},
          "primary_procedure": {"minLength": 1, "type": "string"},
          "reason_code": {"const": "ACCEPTANCE_EVIDENCE_INCOMPLETE"},
          "required_evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"gate": {"const": "Needs review"}}},
      "then": {
        "properties": {
          "allowed": {"const": true},
          "phase": {"const": "Review"},
          "primary_blocker": {"type": "null"},
          "primary_procedure": {"minLength": 1, "type": "string"},
          "reason_code": {"const": "ACCEPTANCE_EVIDENCE_INCOMPLETE"},
          "required_evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"gate": {"const": "Blocked"}}},
      "then": {
        "properties": {
          "allowed": {"const": false},
          "primary_blocker": {
            "properties": {
              "reason_code": {
                "enum": [
                  "AUTHORITY_CONFLICT",
                  "EVIDENCE_CONTRADICTED",
                  "LIFECYCLE_STATE_STALE",
                  "POLICY_CONFLICT",
                  "PRIVATE_INPUT_INCLUDED",
                  "SKILL_UNAVAILABLE"
                ]
              }
            },
            "type": "object"
          },
          "primary_procedure": {"type": "null"},
          "reason_code": {
            "enum": [
              "AUTHORITY_CONFLICT",
              "EVIDENCE_CONTRADICTED",
              "LIFECYCLE_STATE_STALE",
              "POLICY_CONFLICT",
              "PRIVATE_INPUT_INCLUDED",
              "SKILL_UNAVAILABLE"
            ]
          },
          "required_evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"reason_code": {"const": "AUTHORITY_CONFLICT"}}},
      "then": {
        "properties": {
          "allowed": {"const": false},
          "gate": {"const": "Blocked"},
          "primary_blocker": {
            "properties": {
              "reason_code": {"const": "AUTHORITY_CONFLICT"}
            }
          },
          "required_evidence": {"const": ["authority-resolution"]}
        }
      }
    },
    {
      "if": {"properties": {"reason_code": {"const": "PRIVATE_INPUT_INCLUDED"}}},
      "then": {
        "properties": {
          "allowed": {"const": false},
          "gate": {"const": "Blocked"},
          "primary_blocker": {
            "properties": {
              "reason_code": {"const": "PRIVATE_INPUT_INCLUDED"}
            }
          },
          "required_evidence": {"const": ["private-input-exclusion"]}
        }
      }
    },
    {
      "if": {"properties": {"reason_code": {"const": "POLICY_CONFLICT"}}},
      "then": {
        "properties": {
          "allowed": {"const": false},
          "gate": {"const": "Blocked"},
          "primary_blocker": {
            "properties": {
              "reason_code": {"const": "POLICY_CONFLICT"}
            }
          },
          "required_evidence": {"const": ["policy-resolution"]}
        }
      }
    },
    {
      "if": {"properties": {"reason_code": {"const": "LIFECYCLE_STATE_STALE"}}},
      "then": {
        "properties": {
          "allowed": {"const": false},
          "gate": {"const": "Blocked"},
          "primary_blocker": {
            "properties": {
              "reason_code": {"const": "LIFECYCLE_STATE_STALE"}
            }
          },
          "required_evidence": {"const": ["current-lifecycle-state"]}
        }
      }
    },
    {
      "if": {"properties": {"reason_code": {"const": "EVIDENCE_CONTRADICTED"}}},
      "then": {
        "properties": {
          "allowed": {"const": false},
          "gate": {"const": "Blocked"},
          "primary_blocker": {
            "properties": {
              "reason_code": {"const": "EVIDENCE_CONTRADICTED"}
            }
          },
          "required_evidence": {"const": ["contradiction-resolution"]}
        }
      }
    },
    {
      "if": {"properties": {"reason_code": {"const": "SKILL_UNAVAILABLE"}}},
      "then": {
        "properties": {
          "allowed": {"const": false},
          "gate": {"const": "Blocked"},
          "primary_blocker": {
            "properties": {
              "reason_code": {"const": "SKILL_UNAVAILABLE"}
            }
          },
          "required_evidence": {"const": ["procedure-availability"]}
        }
      }
    }
  ],
  "title": "AEC Resolver Decision",
  "type": "object"
}
