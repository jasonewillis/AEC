{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consumer_update": {
      "additionalProperties": false,
      "properties": {
        "auto_merge_allowed": {"const": false},
        "compatibility": {
          "enum": ["compatible", "validation-required", "breaking"]
        },
        "required_probes": {
          "const": ["human-render", "material", "routine"],
          "type": "array"
        }
      },
      "required": [
        "auto_merge_allowed",
        "compatibility",
        "required_probes"
      ],
      "type": "object"
    },
    "contracts": {
      "additionalProperties": false,
      "properties": {
        "consumer_state": {"const": "1.0.0"},
        "human_render": {"const": "1.2.0"},
        "public_card": {"const": "3.0.0"},
        "resolution_decision": {"const": "4.0.0"},
        "resolution_request": {"const": "2.0.0"},
        "workflow": {"const": "1.0.0"}
      },
      "required": [
        "consumer_state",
        "human_render",
        "public_card",
        "resolution_decision",
        "resolution_request",
        "workflow"
      ],
      "type": "object"
    },
    "release": {
      "additionalProperties": false,
      "properties": {
        "channel": {"enum": ["alpha", "beta", "stable"]},
        "notes_url": {
          "const": "https://github.com/jasonewillis/AEC/releases/tag/v0.1.0"
        },
        "published_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
          "type": "string"
        },
        "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "tag": {"const": "v0.1.0"},
        "version": {"const": "0.1.0"}
      },
      "required": [
        "channel",
        "notes_url",
        "published_at",
        "revision",
        "tag",
        "version"
      ],
      "type": "object"
    },
    "repository": {"const": "jasonewillis/AEC"},
    "schema_version": {"const": "1.0.0"}
  },
  "required": [
    "consumer_update",
    "contracts",
    "release",
    "repository",
    "schema_version"
  ],
  "type": "object"
}
