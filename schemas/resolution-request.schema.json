{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonewillis/AEC/schemas/resolution-request.schema.json",
  "additionalProperties": false,
  "properties": {
    "available_procedures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "identity": {"minLength": 1, "type": "string"},
          "revision": {"minLength": 1, "type": "string"}
        },
        "required": ["identity", "revision"],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "active": {"type": "boolean"},
          "identity": {"minLength": 1, "type": "string"},
          "reason_code": {
            "enum": [
              "AUTHORITY_CONFLICT",
              "EVIDENCE_CONTRADICTED",
              "LIFECYCLE_STATE_STALE",
              "POLICY_CONFLICT",
              "PRIVATE_INPUT_INCLUDED"
            ],
            "type": "string"
          }
        },
        "required": ["active", "identity", "reason_code"],
        "type": "object"
      },
      "type": "array"
    },
    "capability_profile": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {"minLength": 1, "type": "string"},
          "type": "array",
          "uniqueItems": true
        },
        "identity": {"minLength": 1, "type": "string"},
        "version": {"minLength": 1, "type": "string"}
      },
      "required": ["capabilities", "identity", "version"],
      "type": "object"
    },
    "consumer_profile": {
      "additionalProperties": false,
      "properties": {
        "aec_mode": {"const": "read-only-mentor"},
        "agent_adapters": {
          "items": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"},
          "minItems": 1,
          "type": "array"
        },
        "lifecycle_authority": {"const": "consumer-owned"},
        "profile_version": {"minLength": 1, "type": "string"},
        "project": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$(?![\\s\\S])",
          "type": "string"
        },
        "schema_version": {"const": "1.0.0"},
        "workflow": {"const": "ticket-to-pr"}
      },
      "required": [
        "aec_mode",
        "agent_adapters",
        "lifecycle_authority",
        "profile_version",
        "project",
        "schema_version",
        "workflow"
      ],
      "type": "object"
    },
    "decision_context": {
      "oneOf": [
        {"$ref": "#/$defs/decision_context"},
        {"type": "null"}
      ]
    },
    "environment": {"minLength": 1, "type": "string"},
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accepted": {"type": "boolean"},
          "environment": {"minLength": 1, "type": "string"},
          "kind": {"minLength": 1, "type": "string"},
          "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
        },
        "required": ["accepted", "environment", "kind", "revision"],
        "type": "object"
      },
      "type": "array"
    },
    "lane": {"minLength": 1, "type": "string"},
    "phase": {
      "enum": [
        "Intake",
        "Framing",
        "Spec",
        "Plan",
        "Build",
        "Verify",
        "Review",
        "PR",
        "Deploy"
      ]
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "additionalProperties": false,
          "properties": {
            "require_exact_environment": {"type": "boolean"},
            "require_exact_revision": {"type": "boolean"}
          },
          "required": ["require_exact_environment", "require_exact_revision"],
          "type": "object"
        },
        "identity": {"minLength": 1, "type": "string"},
        "revision": {"minLength": 1, "type": "string"}
      },
      "required": ["facts", "identity", "revision"],
      "type": "object"
    },
    "required_procedure": {
      "additionalProperties": false,
      "properties": {
        "identity": {"minLength": 1, "type": "string"},
        "revision": {"minLength": 1, "type": "string"}
      },
      "required": ["identity", "revision"],
      "type": "object"
    },
    "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "schema_version": {"const": "2.0.0"},
    "task_id": {"minLength": 1, "type": "string"},
    "workflow": {
      "additionalProperties": false,
      "properties": {
        "identity": {"minLength": 1, "type": "string"},
        "revision": {"minLength": 1, "type": "string"},
        "stage": {
          "enum": ["Understand", "Design", "Execute", "Assure & Release"]
        }
      },
      "required": ["identity", "revision", "stage"],
      "type": "object"
    }
  },
  "required": [
    "available_procedures",
    "blockers",
    "capability_profile",
    "consumer_profile",
    "environment",
    "evidence",
    "lane",
    "phase",
    "policy",
    "required_procedure",
    "revision",
    "schema_version",
    "task_id",
    "workflow"
  ],
  "$defs": {
    "decision_context": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "additionalProperties": false,
          "properties": {
            "owner": {"enum": ["agent", "consumer-owner", "external"]},
            "reason": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"}
          },
          "required": ["owner", "reason"],
          "type": "object"
        },
        "choices": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "identity": {
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])",
                "type": "string"
              },
              "summary": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"},
              "tradeoffs": {
                "additionalProperties": false,
                "properties": {
                  "maintainability": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"},
                  "quality": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"},
                  "reversibility": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"},
                  "risk": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"},
                  "scope": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"}
                },
                "required": ["maintainability", "quality", "reversibility", "risk", "scope"],
                "type": "object"
              }
            },
            "required": ["identity", "summary", "tradeoffs"],
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 2,
          "type": "array"
        },
        "context": {
          "additionalProperties": false,
          "properties": {
            "evidence_quality": {"enum": ["direct-verified", "indirect", "assumed"]},
            "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
          },
          "required": ["evidence_quality", "revision"],
          "type": "object"
        },
        "question": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"},
        "recommendation": {
          "additionalProperties": false,
          "properties": {
            "choice": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"},
            "confidence": {"enum": ["high", "medium", "low"]},
            "expected_result": {
              "additionalProperties": false,
              "properties": {
                "baseline": {"type": "integer"},
                "direction": {"enum": ["increase", "decrease", "hold"]},
                "measure": {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])",
                  "type": "string"
                },
                "target": {"type": "integer"},
                "threshold": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"},
                "unit": {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$(?![\\s\\S])",
                  "type": "string"
                }
              },
              "required": [
                "baseline",
                "direction",
                "measure",
                "target",
                "threshold",
                "unit"
              ],
              "type": "object"
            },
            "principal_uncertainty": {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            "revisit_when": {
              "items": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"},
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "why": {"minLength": 1, "pattern": ".*\\S.*", "type": "string"}
          },
          "required": [
            "choice",
            "confidence",
            "expected_result",
            "principal_uncertainty",
            "revisit_when",
            "why"
          ],
          "type": "object"
        },
        "schema_version": {"const": "2.0.0"}
      },
      "required": [
        "authority",
        "choices",
        "context",
        "question",
        "recommendation",
        "schema_version"
      ],
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"phase": {"enum": ["Intake", "Framing"]}},
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "workflow": {
            "properties": {"stage": {"const": "Understand"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"phase": {"enum": ["Spec", "Plan"]}},
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "workflow": {"properties": {"stage": {"const": "Design"}}}
        }
      }
    },
    {
      "if": {
        "properties": {"phase": {"enum": ["Build", "Verify"]}},
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "workflow": {"properties": {"stage": {"const": "Execute"}}}
        }
      }
    },
    {
      "if": {
        "properties": {"phase": {"enum": ["Review", "PR", "Deploy"]}},
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "workflow": {
            "properties": {"stage": {"const": "Assure & Release"}}
          }
        }
      }
    }
  ],
  "title": "AEC Normalized Resolution Request",
  "type": "object"
}
